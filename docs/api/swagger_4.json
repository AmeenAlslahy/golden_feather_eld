      - TokenQueryAuth: []
  /eld/company-vehicles:
    get:
      tags:
      - 09. Vehicle Display Management | إدارة عرض المركبات والشاحنات
      summary: استرجاع أسطول شاحنات الشركة (Get Company Fleet Vehicles)
      description: |
        استرجاع جميع شاحنات الشركة الناقلة بالاستعلام الحي من قاعدة بيانات Traccar المركزية.

        **قواعد العزل والأمان:**
        - تُعرض فقط الشاحنات التابعة لنفس الشركة الناقلة (multi-tenancy isolation)
        - لا تُكشف بيانات الامتثال أو ساعات العمل أو مخالفات سائقين آخرين

        **الحالات التشغيلية:**
        - `AVAILABLE` — متاحة: غير معطلة وغير مستخدمة حالياً
        - `IN_USE` — قيد الاستخدام: سائق آخر لديه جلسة نشطة عليها
        - `OUT_OF_SERVICE` — خارج الخدمة: معطلة أو فحص DVIR الأخير غير سليم

        **مؤشر التخصيص (`assignedToCurrentDriver`):**
        يشير إلى أن السائق يملك صلاحية ربط هذه الشاحنة بجلسته.
      operationId: getCompanyVehicles
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري — يُستخدم معرف المستخدم الحالي إذا لم يُحدد)
        schema:
          type: integer
          format: int64
        example: 101
      responses:
        "200":
          description: ملخص أسطول الشركة وقائمة الشاحنات التفصيلية
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CompanyVehiclesSummaryResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/company-vehicles/my-vehicles:
    get:
      tags:
      - 09. Vehicle Display Management | إدارة عرض المركبات والشاحنات
      summary: استرجاع المركبات الخاصة بالسائق (Get My Vehicles)
      description: استرجاع المركبات المخصصة مباشرة للسائق وفق Traccar (SRS v1.1 -
        القسم 8).
      operationId: getMyVehicles
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري)
        schema:
          type: integer
          format: int64
        example: 101
      responses:
        "200":
          description: قائمة المركبات المخصصة مباشرة للسائق وتصنيفاتها
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/DriverVehicleClassification"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
