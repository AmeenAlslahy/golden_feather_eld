openapi: 3.0.1
info:
  title: Traccar ELD / HOS Engine REST API
  description: واجهة برمجة التطبيقات الكاملة لنظام إدارة ساعات الخدمة (HOS) والسجلات
    الإلكترونية (ELD) المولدة تلقائياً من OpenAPI Annotations في الـ Controllers
  contact:
    name: ELD Core Engineering Team
    email: support@traccar.org
  version: 1.0.0
servers:
- url: /api
  description: Current Server (Traccar + ELD)
security:
- BearerAuth: []
- BasicAuth: []
- TokenQueryAuth: []
tags:
- name: 01. Account & Profile Management | إدارة الحساب والملف الشخصي
  description: عرض بيانات الملف الشخصي وحصر صلاحيات التعديل بمدير الأسطول Fleet Manager
- name: 01.1 My Account | شاشة حسابي لتطبيق السائق
  description: عرض بيانات السائق والناقل والرخصة والمنطقة الزمنية كبيانات للقراءة
    فقط، مع تمكين تعديل اللغة ووحدة المسافة
- name: 02.3 Status Dashboard | لوحة الحالة لتطبيق السائق
  description: شاشة لوحة الحالة ومؤشرات HOS كقيم مستهلكة ودائرة التقدم والملخص الأسبوعي
    وتعديل الحالة
- name: 04. Driver Rules Screen | شاشة إعدادات القواعد لتطبيق السائق
  description: عرض دورة العمل ونوع الحمولة وإعادة التشغيل واستثناء 16 ساعة وتعديل
    الخيارات القابلة للتغيير مع الحفاظ على الحالات الثابتة المحمية للقراءة فقط
- name: 05. Daily Logs Management | إدارة السجلات اليومية والاعتماد
  description: إدارة السجلات اليومية، تفاصيل السجل، الاعتماد الرقمي، القفل النظامي،
    وشبكة Graph-Grid الرسمية
- name: 05.1 Driver Session Management | إدارة جلسة السائق والاتصال
  description: إدارة جلسة السائق النشطة والاتصال بالمركبة أو الجهاز الفيزيائي (ELD
    Hardware)
- name: 05.2 Duty Status Events & Graph-Grid | أحداث حالات الواجب والشبكة البيانية
    24 ساعة
  description: تسجيل أحداث الواجب وتعديل الأحداث اليدوية وعرض الرسم البياني على مدار
    24 ساعة وتقسيم منتصف الليل
- name: 05.4 Team Drivers & HOS Isolation | السائق المساعد وفريق القيادة والعزل التام
  description: استرجاع حالة السائق المساعد في السجل اليومي، وتطبيق العزل التام لساعات
    وقواعد HOS بين السائقين بموجب FMCSA
- name: 05.5 Team Driving & Co-Driver Roles | السائق المساعد وقيادة الفريق والعزل
    التام
  description: إدارة السائق المساعد لقيادة الفريق (Team Driving)، ربط/إضافة/تبديل/إزالة
    السائق المساعد وتبديل الأدوار وفق اشتراطات FMCSA
- name: 07. DVIR Management | الفحص اليومي للمركبة والمقطورة
  description: إدارة تقارير الفحص اليومي DVIR، تسجيل وتصديق العيوب، مراجعة فحص ما
    قبل الرحلة Pre-Trip، والامتثال لـ 49 CFR § 396.11
- name: 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
  description: إدارة وضع التفتيش الرقابي الميداني، حزمة المعلومات الإلزامية للمركبة،
    عرض السجلات القانونية للمفتش، ونقل السجلات لـ FMCSA وفق 49 CFR § 395.22/24/32
- name: 08.1 Unidentified Events | أحداث القيادة غير المحددة والمقترحة
  description: إدارة أحداث القيادة غير المسندة، مطالبتها، رفضها، ومراقبة الالتزام
    بمهلة الـ 8 أيام القانونية بموجب 49 CFR § 395.32
- name: 09. Vehicle Display Management | إدارة عرض المركبات والشاحنات
  description: عرض جميع شاحنات الشركة الناقلة مع حالتها التشغيلية وعداداتها مع عزل
    الشركات وحجب البيانات الحساسة
- name: 10. Hardware Connectivity | إدارة الاتصال بالجهاز الفيزيائي
  description: إدارة الاتصال بأجهزة ELD وفحص الجاهزية التشغيلية والتحقق من قنوات البيانات
    ومنع القيادة الآلية غير الصالحة والتحويل للتسجيل اليدوي (§395.34)
- name: 11. HOS Rules Engine | محرك قواعد ساعات العمل
  description: إدارة القواعد التنظيمية الفيدرالية والولائية والدولية، وتطبيق دورات
    العمل ونوع الحمولة والاستثناءات وتقييم Short-Haul والتصنيف القانوني
- name: 11.1 Driver HOS Rules | قواعد ساعات عمل السائقين واللقطات المجمدة
  description: إدارة القواعد المطبقة فعلياً على السائق وتاريخ اللقطات المجمدة والاستثناءات
    التشغيلية والقطاعية
- name: 13. Log Transfer & Delivery Management | إدارة نقل وتصدير السجلات والتسليم
    الخارجي
  description: تجميع ونقل حزم السجلات الرسمية عبر خدمات الويب والبريد الإلكتروني الآلي
    وتوثيق سجل التدقيق والتحميل المباشر
- name: 15. About & Diagnostics | إدارة حول التطبيق والتشخيص
  description: معلومات التطبيق وحالة الاتصال بالخادم المركزي والجهاز، ومراقبة الأعطال
    التشخيصية وصحة النظام
- name: 16. ELD & HOS Reports | تقارير السجلات الإلكترونية والتصدير
  description: توليد وتصدير تقارير ELD اليومية والأسبوعية والتنفيذية بصيغ PDF و CSV
    و HTML و XML
- name: 17. Fleet Statistics & Scores | إحصائيات ومؤشرات الأسطول
  description: إحصائيات الأسطول، نسب الامتثال وحساب درجات الامتثال بالأوزان الجزائية
- name: 18. Compliance Evaluation | تقييم الامتثال وساعات HOS المتبقية
  description: تقييم امتثال السائقين وتدقيق المخالفات واحتساب ساعات HOS المتبقية
- name: 19. System Configuration | إعدادات النظام وقواعد ELD
  description: استرجاع إعدادات نظام ELD وقواعد العمل والمعاملات التشغيلية
- name: Fleet Manager Dashboard | لوحة قيادة مدير الأسطول
  description: ملخص مباشر للأسطول وبث التحديثات اللحظية عبر Server-Sent Events (SSE)
    ومتابعة الجلسات لمدير الأسطول فقط
paths:
  /eld/compliance/evaluate/{driverId}:
    get:
      tags:
      - 18. Compliance Evaluation | تقييم الامتثال وساعات HOS المتبقية
      summary: تقييم امتثال السائق (Evaluate Driver Compliance)
      description: تقييم امتثال السائق لقواعد ساعات الخدمة HOS في آخر 8 أيام واكتشاف
        المخالفات
      operationId: evaluateCompliance
      parameters:
      - name: driverId
        in: path
        description: معرف السائق
        required: true
        schema:
          type: integer
          format: int64
        example: 479
      responses:
        "200":
          description: تمت العملية بنجاح
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/compliance/remaining/{driverId}:
    get:
      tags:
      - 18. Compliance Evaluation | تقييم الامتثال وساعات HOS المتبقية
      summary: استرجاع ساعات HOS المتبقية (Get Remaining Hours)
      description: حساب الساعات المتبقية للقيادة والوردية والاستراحة ودورة العمل
      operationId: getRemainingHours
      parameters:
      - name: driverId
        in: path
        description: معرف السائق
        required: true
        schema:
          type: integer
          format: int64
        example: 479
      responses:
        "200":
          description: تمت العملية بنجاح
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/email-logs:
    post:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: إرسال السجلات عبر البريد الإلكتروني (Email Logs to Inspector)
      description: إرسال ملف السجلات بصيغة PDF أو FMCSA CSV عبر البريد الإلكتروني
        للمفتش مع رمز التوجيه والتعليق
      operationId: emailLogs
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/EmailLogsRequest"
      responses:
        "200":
          description: تم إرسال السجلات بالبريد الإلكتروني وتسجيل العملية بنجاح
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LogTransferResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/cycle:
    get:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: عرض سجلات الدورة الكاملة للتفتيش (Cycle Logs - 8 Days or Audit Scope)
      description: استرجاع قائمة بسجلات الأيام السابقة (افتراضياً 8 أيام للتفتيش الميداني
        على الطريق، وحتى 180 يوماً لأغراض التدقيق والتحقيق)
      operationId: getCycleLogs
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      - name: days
        in: query
        description: عدد الأيام (افتراضياً 8 أيام، بحد أقصى 180 يوماً)
        schema:
          type: integer
          format: int32
          default: 8
      - name: endDate
        in: query
        description: تاريخ نهاية النطاق (YYYY-MM-DD، افتراضياً اليوم)
        schema:
          type: string
      responses:
        "200":
          description: تم استرجاع سجلات الدورة بنجاح
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/InspectionLogDisplayResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection:
    get:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: استرجاع بيانات شاشة وضع التفتيش (DOT Inspection Screen)
      description: عرض الشاشة الرئيسية للتفتيش الإرشادي لـ 8 أيام (24 ساعة الحالية
        + 7 أيام سابقة)، بيان الامتثال القانوني، وأزرار الإجراءات
      operationId: getDotInspectionScreen
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      responses:
        "200":
          description: تم استرجاع بيانات شاشة التفتيش بنجاح
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DotInspectionScreenResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/information-packet:
    get:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: فحص واسترجاع حزمة المعلومات الإلزامية (Information Packet - 49 CFR
        § 395.22(h))
      description: "التحقق من توفر المواد الأربعة الإلزامية على متن المركبة: دليل\
        \ المستخدم، تعليمات نقل البيانات، تعليمات الأعطال، وأوراق السجلات اليدوية\
        \ لـ 8 أيام"
      operationId: getInformationPacket
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      responses:
        "200":
          description: تم استرجاع تفاصيل حزمة المعلومات وحالة اكتمالها بنجاح
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/InformationPacketResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/logs:
    get:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: عرض سجل التفتيش ليوم محدد (Inspection Log Display)
      description: عرض الترويسة الكاملة الرسمية لـ FMCSA، الرسم البياني 24 ساعة، جدول
        الأحداث مع الحدث السابق وحدث التصديق، في وضع قراءة فقط صارم
      operationId: getInspectionLog
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      - name: date
        in: query
        description: تاريخ السجل المطلوب (YYYY-MM-DD، افتراضياً اليوم)
        schema:
          type: string
      responses:
        "200":
          description: تم استرجاع سجل اليوم المحدد للتفتيش بنجاح
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/InspectionLogDisplayResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/transfers:
    get:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: استرجاع سجل عمليات نقل السجلات التاريخية (Log Transfer Audit Trail)
      description: سجل تدقيق تاريخي غير قابل للتعديل لجميع عمليات نقل السجلات الإلكترونية
        للمفتشين والهيئات الرقابية
      operationId: getTransfers
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      responses:
        "200":
          description: تم استرجاع سجل عمليات النقل بنجاح
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/send-logs:
    post:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: إرسال السجلات إلكترونياً للمفتش (Send Logs to FMCSA)
      description: توليد ملف FMCSA القياسي (Appendix A CSV) وإرساله عبر قنوات الاتصال
        المعتمدة (Web Services / Email) مع تعليق المفتش الإلزامي (4-60 حرفاً)
      operationId: sendLogs
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/SendLogsRequest"
      responses:
        "200":
          description: تم نقل السجلات وتسجيل العملية في سجل التدقيق غير القابل للتعديل
            بنجاح
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LogTransferResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/dot-inspection/start:
    post:
      tags:
      - 08. DOT Inspection & ELD Records Transfer | التفتيش وحزمة المعلومات ونقل السجلات
      summary: بدء وضع التفتيش وقفله للقراءة فقط (Start DOT Inspection Mode)
      description: تفعيل وضع التفتيش الإرشادي لتسليم الجهاز للمفتش وقفل الواجهة في
        وضع القراءة فقط (Read-Only) لمنع أي تعديل أو عبث
      operationId: startDotInspection
      parameters:
      - name: driverId
        in: query
        description: معرف السائق (اختياري، افتراضياً السائق الحالي)
        schema:
          type: integer
          format: int64
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StartDotInspectionRequest"
      responses:
        "200":
          description: تم بدء وضع التفتيش بنجاح وقفل الواجهة للقراءة فقط
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DotInspectionScreenResponse"
        "400":
          description: طلب غير صالح أو بيانات مدخلة غير صحيحة
        "401":
