          / رقم المعرف)
        schema:
          type: string
        example: 123456
      - name: disconnected
        in: query
        description: وضع الاستمرار دون اتصال (Disconnected Mode §395.34)
        schema:
          type: boolean
          default: false
        example: false
      responses:
        "200":
          description: تم الاتصال بالمركبة وبدء الجلسة بنجاح
          content:
            application/json:
              schema:
