        description: سبب التبديل (خاص بإجراء switch-primary)
        schema:
          type: string
        example: تبادل القيادة أثناء الاستراحة
      responses:
        "200":
          description: تم تبديل الدور بنجاح
        "400":
          description: خطأ في المعاملات المدخلة أو إجراء غير صالح
        "401":
          description: غير مصرح — يلزم تسجيل الدخول والمصادقة
        "403":
          description: محظور — ليس لديك صلاحية على هذا المورد
        "500":
          description: خطأ داخلي في الخادم أو قاعدة البيانات
      security:
      - BearerAuth: []
      - BasicAuth: []
      - TokenQueryAuth: []
  /eld/sessions/connect:
    post:
      tags:
      - 05.1 Driver Session Management | إدارة جلسة السائق والاتصال
      summary: الاتصال بالمركبة أو الجهاز الفيزيائي (Connect Vehicle / Hardware Device)
      description: |
        نقطة نهاية موحدة لربط السائق بالمركبة أو جهاز ELD أو الـ Hardware وبدء الجلسة التشغيلية.
        - لا تتطلب Request Body؛ يتم تحديد السائق تلقائياً من التوكن (Bearer Token).
        - يمكن تمرير المعرف الفريد للجهاز (uniqueId / IMEI / رقم المعرف) كـ Query Param.
        - في حال عدم تمرير أي معرف، يتم الاتصال تلقائياً بالمركبة المخصصة للسائق في Traccar.
      operationId: connect
      parameters:
