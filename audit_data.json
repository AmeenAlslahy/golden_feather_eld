  "pubspec": "name: golden_feather_eld\ndescription: Golden Feather ELD - Electronic Logging Device for Field Compliance Tracking\npublish_to: 'none'\nversion: 1.0.0+1\n\nenvironment:\n  sdk: '>=3.2.0 <4.0.0'\n\ndependencies:\n  flutter:\n    sdk: flutter\n  flutter_localizations:\n    sdk: flutter\n  intl: ^0.20.2\n  \n  # Clean Architecture & State Management\n  flutter_riverpod: ^2.5.1\n  riverpod_annotation: ^2.3.5\n  go_router: ^14.2.0\n  \n  # Functional Programming\n  dartz: ^0.10.1\n  equatable: ^2.0.5\n  \n  # Network\n  dio: ^5.4.3+1\n  connectivity_plus: ^6.0.3\n  \n  # Local Storage\n  shared_preferences: ^2.2.3\n  hive_flutter: ^1.1.0\n  hive: ^2.2.3\n  flutter_secure_storage: ^10.3.1\n  \n  # Tracking\n  geolocator: ^12.0.0\n  geocoding: ^3.0.0\n  \n  # UI\n  google_fonts: ^6.2.1\n  flutter_screenutil: ^5.9.3\n  shimmer: ^3.0.0\n  cached_network_image: ^3.3.1\n  \n  # Media\n  image_picker: ^1.0.7\n  signature: ^6.4.0\n  \n  # QR & Barcode\n  mobile_scanner: ^5.1.1\n  \n  # Firebase\n  firebase_core: ^2.30.1\n  firebase_crashlytics: ^3.5.5\n  firebase_messaging: ^14.9.1\n  \n  # Export\n  pdf: ^3.11.1\n  share_plus: ^9.0.0\n  \n  # Utils\n  path_provider: ^2.1.3\n  package_info_plus: ^8.0.0\n  url_launcher: ^6.3.0\n  uuid: ^4.4.0\n  logger: ^2.3.0\n  permission_handler: ^11.3.1\n  quick_actions: ^1.1.0\n  sqflite: ^2.4.2\n  path: ^1.9.1\n  flutter_dotenv: ^6.0.1\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  flutter_lints: ^4.0.0\n  riverpod_generator: ^2.4.0\n  build_runner: ^2.4.9\n  mocktail: ^1.0.3\n  very_good_analysis: ^5.1.0\n  flutter_launcher_icons: ^0.14.4\n  http_mock_adapter: ^0.6.1\n\nflutter:\n  uses-material-design: true\n  \n  assets:\n    - assets/images/\n    - assets/icons/\n    - assets/fonts/\n    - .env\n  \n  generate: true\n\nflutter_launcher_icons:\n  android: true\n  ios: true\n  image_path: \"assets/images/ic_launcher.png\"\n  adaptive_icon_background: \"#0072CE\"\n  adaptive_icon_foreground: \"assets/images/ic_launcher.png\"\n\n"
